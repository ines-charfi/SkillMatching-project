create table users
(
    id            bigint auto_increment
        primary key,
    date_creation datetime(6)                              null,
    email         varchar(255)                             not null,
    enabled       bit                                      null,
    password      varchar(255)                             null,
    provider      varchar(255)                             null,
    provider_id   varchar(255)                             null,
    role          enum ('CANDIDAT', 'ENTREPRISE', 'ADMIN') not null,
    constraint UK_6dotkott2kjsp8vw4d0m25fb7
        unique (email)
);

create table candidats
(
    id                bigint auto_increment
        primary key,
    adresse           varchar(255)                            null,
    bio               text                                    null,
    competences       text                                    null,
    cv_path           varchar(255)                            null,
    date_creation     datetime(6)                             null,
    linkedin_url      varchar(255)                            null,
    niveau_scolaire   varchar(255)                            null,
    nom               varchar(255)                            not null,
    photo_path        varchar(255)                            null,
    portfolio_url     varchar(255)                            null,
    prenom            varchar(255)                            not null,
    telephone         varchar(255)                            null,
    user_id           bigint                                  not null,
    validation_statut enum ('EN_ATTENTE', 'VALIDE', 'REJETE') null,
    constraint UK_hpvh71iyyqy4pedo52vl45imt
        unique (user_id),
    -- AJOUT FK
    constraint FK_candidat_user foreign key (user_id) references users (id) on delete cascade
);

create table entreprises
(
    id             bigint auto_increment
        primary key,
    contact_email  varchar(255) null,
    description    text         null,
    logo_path      varchar(255) null,
    nom_entreprise varchar(255) not null,
    secteur        varchar(255) null,
    site_web       varchar(255) null,
    telephone      varchar(255) null,
    user_id        bigint       not null,
    constraint UK_6utemjat1kwgfbtswhqq5p8jd
        unique (user_id),
    -- AJOUT FK
    constraint FK_entreprise_user foreign key (user_id) references users (id) on delete cascade
);

create table offres
(
    id                   bigint auto_increment
        primary key,
    active               bit          null,
    competences_requises text         null,
    date_publication     datetime(6)  null,
    description          text         not null,
    entreprise_id        bigint       not null,
    niveau_requis        varchar(255) null,
    salaire              varchar(255) null,
    titre                varchar(255) not null,
    constraint fk_offre_entreprise
        foreign key (entreprise_id) references entreprises (id)
            on delete cascade -- déjà présente
);

create table candidatures
(
    id               bigint auto_increment
        primary key,
    candidat_id      bigint                                   not null,
    date_postulation datetime(6)                              null,
    offre_id         bigint                                   not null,
    score_matching   int                                      null,
    statut           enum ('EN_ATTENTE', 'ACCEPTE', 'REFUSE') null,
    -- AJOUT FK
    constraint FK_candidature_candidat foreign key (candidat_id) references candidats (id) on delete cascade,
    constraint FK_candidature_offre    foreign key (offre_id)    references offres (id)    on delete cascade
);

create table entretiens
(
    id             bigint auto_increment
        primary key,
    candidature_id bigint                                  not null,
    date_entretien datetime(6)                             not null,
    lieu           varchar(255)                            null,
    notes          text                                    null,
    statut         enum ('PROGRAMME', 'TERMINE', 'ANNULE') null,
    -- AJOUT FK
    constraint FK_entretien_candidature foreign key (candidature_id) references candidatures (id) on delete cascade
);

create table experiences
(
    id             bigint auto_increment
        primary key,
    date_debut     date         null,
    date_fin       date         null,
    description    text         null,
    entreprise_nom varchar(255) not null,
    poste          varchar(255) not null,
    candidat_id    bigint       not null,
    constraint FKbgxhotrb4op8av1orb166gl27
        foreign key (candidat_id) references candidats (id) -- déjà présente (sans ON DELETE, je l'ai laissée telle quelle)
);