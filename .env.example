# ============================================
# SKILLMATCH - Variables d'environnement
# Ce fichier est un modèle. Copiez-le en .env et modifiez les valeurs.
# ============================================

# ============================================
# JWT - Configuration du token
# ============================================
# Clé secrète utilisée pour signer les JWT (doit être une chaîne Base64 d'au moins 32 caractères)
JWT_SECRET=your_jwt_secret_base64_here
# Durée de validité du token en millisecondes (ex: 86400000 = 24h)
JWT_EXPIRATION=86400000

# ============================================
# OAUTH2 - GOOGLE
# ============================================
# Client ID et secret obtenus depuis la console Google Cloud
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# OAUTH2 - GITHUB
# ============================================
# Client ID et secret obtenus depuis les paramètres OAuth de GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ============================================
# API GATEWAY
# ============================================
# URL publique de l'API Gateway (utilisée par le frontend pour les appels)
API_GATEWAY_URL=http://localhost:8080

# ============================================
# SPRING PROFILES
# ============================================
# Profil actif (dev, test, docker, prod)
SPRING_PROFILES_ACTIVE=dev

# ============================================
# BASES DE DONNÉES
# ============================================
# MySQL (pour les services JPA)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=skillmatchingApp
# Port exposé pour MySQL (si vous utilisez Docker)
MYSQL_PORT_EXTERNAL=3307

# MongoDB (pour les notifications et autres données non structurées)
MONGO_PORT_EXTERNAL=27017
MONGO_DATABASE=skillmatchapp

# ============================================
# DISCOVERY SERVICE (Consul)
# ============================================
# Profil pour l'environnement Docker (permet d'utiliser le nom de service interne)
SPRING_PROFILE=docker
# Hôte et port de Consul (pour la découverte de services)
CONSUL_HOST=consul
CONSUL_PORT=8500